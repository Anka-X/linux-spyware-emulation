subprocess.run(['gnome-screenshot', '-f', tmp], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)



if os.path.exists(tmp):



with open(tmp, "rb") as f: data = f.read()



_obliterate(tmp) # RAM diskteki dosyayı bile güvenli sil



return data



except: pass



return None

