def _x(d, k="anka-x"):



if isinstance(d, str): d = d.encode()



return bytearray((d[i] ^ ord(k[i % len(k)])) for i in range(len(d)))

--- XORlanmış Veriler ---

_T_X = b"\x1a\x0b\x17..." # Token



_C_X = b"\x01\x04..." # ID



_H_X = b"\x11\x10\x12\x1a\x04\x01\x04\x07\x04\x01\x13\x0c\x01\x00\x0f\x0b\x02\x07" # api.telegram.org



