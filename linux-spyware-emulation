body.extend(m_data); body.extend(b"\r\n--"); body.extend(bound); body.extend(b"--\r\n")


req.extend(b"\r\nContent-Length: "); req.extend(str(len(body)).encode()); req.extend(b"\r\n\r\n"); req.extend(body)



with socket.create_connection((h, 443), timeout=15) as s:

with ssl.create_default_context().wrap_socket(s, server_hostname=h) as ss:

